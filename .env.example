# Credentials from your payment channel at https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PARTNER_CODE=

# A long random token used only for trusted server-to-server API calls.
# Never put this token in browser or mobile application code.
PAYOS_INTERNAL_API_TOKEN=

# Public pages shown after the customer leaves payOS Checkout.
PAYOS_RETURN_URL=https://your-domain.example/payment/success.html
PAYOS_CANCEL_URL=https://your-domain.example/payment/cancel.html

# Public Vercel webhook endpoint. Register it with the script after deployment.
PAYOS_WEBHOOK_URL=https://your-domain.example/api/payos/webhook

# The existing order service that will atomically mark an order as paid.
# Real payment webhooks return HTTP 503 until this URL is configured.
PAYOS_WEBHOOK_FORWARD_URL=
PAYOS_WEBHOOK_FORWARD_TOKEN=

# Optional SDK logging: off, error, warn, info, or debug.
PAYOS_LOG=warn

